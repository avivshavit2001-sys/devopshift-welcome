pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building Flask application...'
                sh 'docker build -t flask-app .'
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
                sh 'python -m pytest'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh 'docker run -d -p 5000:5000 --name flask-app flask-app'
            }
        }
    }
}