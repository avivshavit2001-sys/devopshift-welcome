pipeline {
    agent any

    environment {
        APP_ENV = 'production'
        APP_DEBUG = 'false'
    }

    stages {
        stage('Build') {
            steps {
                echo "Building Volt app in environment: ${env.APP_ENV}"
                echo "Debug mode is set to: ${env.APP_DEBUG}"
            }
        }
        stage('Deploy') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'my-credentials-id', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
                    echo "Deploying with username ${env.USERNAME}"
                    echo "Deploying with password ${env.PASSWORD}"
                }
            }
        }
    }
}